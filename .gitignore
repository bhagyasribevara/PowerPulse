.venv/
__pycache__/
*.pyc
.pytest_cache/

# System & IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & Secrets
*.zip
*.log
.kaggle/
.env
.env.*
docx_text.txt
