# Raw Data Directory (Ignored to keep raw dataset off GitHub)
data/raw/

# Processed Data Directory (Ignore temp files, un-ignore features.csv)
data/processed/*
!data/processed/features.csv

# Model Directory (Ignore temp models, un-ignore trained xgb_model.pkl)
model/*
!model/xgb_model.pkl

